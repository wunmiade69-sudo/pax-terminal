# Debian ARM64 userspace bundled by the Android build workflow.
# Package updates and additional packages are installed inside the app's private rootfs.
FROM --platform=$TARGETPLATFORM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       ca-certificates \
       curl \
       wget \
       git \
       openssh-client \
       nodejs \
       npm \
       python3 \
       python3-dev \
       python3-pip \
       python3-venv \
       python-is-python3 \
       build-essential \
       pkg-config \
       jq \
       unzip \
       zip \
       xz-utils \
       procps \
       file \
       less \
       nano \
       android-sdk \
       android-sdk-platform-tools \
    && apt-get clean \
    && npm install --global pnpm typescript tsx \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN mkdir -p /home/pax /workspace /tmp /dev /proc /sys \
    && chmod 1777 /tmp

ENV HOME=/home/pax
ENV USER=pax
ENV LOGNAME=pax
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /home/pax
# Verify the runtimes during image construction so a broken download fails the build.
RUN node --version \
    && npm --version \
    && pnpm --version \
    && tsc --version \
    && tsx --version \
    && python --version \
    && python3 --version \
    && git --version \
    && deno --version \
    && bun --version

CMD ["/bin/bash"]
