# Minimal Debian ARM64 environment for PAX Terminal.
# Larger development tools are installed on demand with pkg/apt.
FROM --platform=$TARGETPLATFORM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       ca-certificates \
       curl \
       wget \
       git \
       openssh-client \
       less \
       nano \
       procps \
       file \
       unzip \
       zip \
       xz-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN mkdir -p /home/pax /workspace /tmp /dev /proc /sys \
    && chmod 1777 /tmp

ENV HOME=/home/pax
ENV USER=pax
ENV LOGNAME=pax
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /home/pax

RUN bash --version \
    && apt-get --version \
    && git --version \
    && curl --version

CMD ["/bin/bash"]
